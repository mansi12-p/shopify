<style>
  .browse-by-collection {
    background: #F0F0F0;
    border-radius: 40px;
    padding: 76px;
    margin-top: 76px;
  }

  .heading h2 {
    font-weight: 700;
    font-size: 48px;
    line-height: 100%;
    text-align: center;
    margin-bottom: 40px;
  }

  .collection-wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .collection-item {
    background: white;
    padding: 24px;
    border-radius: 16px;
  }
  .collection-item a {
    text-decoration: none;
    display: flex;
}
  .collection-image {
    flex-shrink: 0;
    margin-right: 20px;
  }

  .collection-image img {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 12px;
  }

  .collection-title h3 {
    font-size: 20px;
    font-weight: 600;
    margin: 0;
    text-decoration: none;
  }

  @media screen and (max-width: 768px) {
    .collection-wrapper {
      grid-template-columns: 1fr; 
    }

    .collection-item {
      flex-direction: column;
      text-align: center;
    }

    .collection-image {
      margin: 0 0 16px 0;
    }
  }
</style>

<div class="browse-by-collection page-width">
  <div class="browse-by-collection-wrapper">
    <div class="heading">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
    </div>
    <div class="collection-wrapper">
      {% assign collections = section.settings.collection_list %}
      {% for collection in collections %}
        <div class="collection-item">
          <a href="{{ collection.url }}">
            <div class="collection-title">
            <h3>{{ collection.title }}</h3>
            </div>
            {% if collection.image %}
              <div class="collection-image">
                <img src="{{ collection.image | img_url: 'medium' }}" alt="{{ collection.title }}">
              </div>
            {% else %}
              <p>No image available</p>
            {% endif %}
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Section name",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "collection_list",
        "id": "collection_list",
        "label": "Collections"
      }
    ],
    "presets": [
      {
        "name": "Browse By collection"
      }
    ]
  }
{% endschema %}
