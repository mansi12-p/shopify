<style>
  .browse-by-collection {
    background: #F0F0F0;
    border-radius: 40px;
    padding: 76px;
    margin-top: 76px;
}
  .heading h2 {
    font-weight: 700;
    font-size: 48px;
    line-height: 100%;
    vertical-align: middle;
    text-align: center;
}
  .collection-wrapper {
    display: flex;
    gap: 24px;
    flex-wrap: nowrap;
}
</style>
<div class="browse-by-collection page-width">
  <div class="browse-by-collection-wrapper">
    <div class="heading">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
    </div>
    <div class="collection-wrapper">
      {% assign collections = section.settings.collection_list %}
      {% for collection in collections %}
        <div class="collection-item">
          <a href="{{ collection.url }}">
            <div class="collection-title">
            <h3>{{ collection.title }}</h3>
            </div>
            {% if collection.image %}
              <div class="collection-image">
                <img src="{{ collection.image | img_url: 'medium' }}" alt="{{ collection.title }}">
              </div>
            {% else %}
              <p>No image available</p>
            {% endif %}
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Section name",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "collection_list",
        "id": "collection_list",
        "label": "Collections"
      }
    ],
    "presets": [
      {
        "name": "Browse By collection"
      }
    ]
  }
{% endschema %}
