<style>
  .custom-banner {
    background: #F2F0F1;
    padding: 40px 0;
  }

  .custom-banner-wrapper {
    display: flex;
    flex-wrap: nowrap;
    gap: 20px;
    width: 100%;
    align-items: center;
    justify-content: space-between;
  }

  .left-side-container {
    flex: 1;
  }

  .right-side-block {
    flex: 1;
    text-align: right;
  }

  .top-content .heading {
    font-weight: 700;
    font-size: 64px;
    line-height: 1.1;
    margin: 0;
  }

  .top-content .sub-heading {
    font-weight: 400;
    font-size: 16px;
    line-height: 22px;
    margin-bottom: 32px;
  }

  .top-content .custom-button {
    padding: 16px 54px;
    border: none;
    border-radius: 64px;
    background: black;
    color: white;
    text-decoration: none;
    display: inline-block;
    margin-top: 16px;
  }

  .bottom-content {
    margin-top: 48px;
    display: flex;
    flex-wrap: wrap;
    gap: 2%;
  }

  .content {
    border-right: 1px solid rgba(0, 0, 0, 0.1);
    padding-right: 16px;
    margin-right: 16px;
  }

  .content:last-child {
    border-right: none;
    margin-right: 0;
    padding-right: 0;
  }

  .counts {
    font-weight: 700;
    font-size: 40px;
    line-height: 1;
    margin-right: 16px;
  }

  .info {
    font-weight: 400;
    font-size: 16px;
    line-height: 22px;
    padding-top: 6px;
  }

  .banner-image img {
    max-width: 100%;
    height: auto;
    border-radius: 16px;
  }

  @media screen and (max-width: 1024px) {
    .custom-banner-wrapper {
      flex-direction: column;
      align-items: flex-start;
      gap: 40px;
    }

    .right-side-block {
      text-align: center;
      width: 100%;
    }

    .top-content .heading {
      font-size: 42px;
      text-align: left;
    }

    .bottom-content {
      flex-direction: column;
      gap: 24px;
    }

    .content {
      border-right: none;
      padding-right: 0;
      margin-right: 0;
    }

    .counts {
      font-size: 32px;
    }

    .top-content .custom-button {
      padding: 14px 36px;
      font-size: 14px;
    }
  }

  @media screen and (max-width: 600px) {
    .top-content .heading {
      font-size: 32px;
      line-height: 1.2;
    }

    .top-content .sub-heading {
      font-size: 14px;
    }

    .counts {
      font-size: 28px;
    }

    .info {
      font-size: 14px;
    }

    .top-content .custom-button {
      width: 100%;
      text-align: center;
    }
  }
</style>

<div class="custom-banner">
  <div class="custom-banner-wrapper  page-width">
    <div class="left-side-container">
      <div class="top-content">
        {% if section.settings.text != blank %}
          <h2 class="heading">{{ section.settings.text }}</h2>
        {% endif %}
        {% if section.settings.sub_text != blank %}
          <div class="sub-heading">{{ section.settings.sub_text }}</div>
        {% endif %}
        {% if section.settings.button_text != blank and section.settings.button_url != blank %}
          <a class="custom-button" href="{{ section.settings.button_url }}">{{ section.settings.button_text }}</a>
        {% endif %}
      </div>
      <div class="bottom-content">
        {% for block in section.blocks %}
          <div class="content">
            {% if block.settings.counts != blank %}
              <div class="counts">{{ block.settings.counts }}</div>
            {% endif %}
            {% if block.settings.label != blank %}
              <div class="info">{{ block.settings.label }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="right-side-block">
      <div class="banner-image">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 400 | image_tag }}
        {% endif %}
      </div>
    </div>
    
  </div>
</div>
{% schema %}
{
  "name": "Section name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "sub_text",
      "label": "Sub Heading"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URl"
    }
  ],
  "blocks": [
    {
      "type": "info-block",
      "name": "Information",
      "settings": [
        {
          "type": "text",
          "id": "counts",
          "label": "Counts"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Information"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
