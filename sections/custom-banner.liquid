<style>
    .custom-banner {
      background: #F2F0F1;
    }
    .custom-banner-wrapper {
      display: flex;
      flex-wrap: nowrap;
      gap: 20px;
      width: 100%;
    }
    .left-side-container {
      align-content: center;
    }
    .top-content .heading {
      font-weight: 700;
      font-size: 64px;
      line-height: 64px;
      vertical-align: middle;
    }
    .top-content .sub-heading {
      font-weight: 400;
      font-size: 16px;
      line-height: 22px;
      margin-bottom: 32px;
    }
    .top-content .custom-button {
      padding: 16px 54px;
      border: none !important;
      border-radius: 64px;
      background: black;
      color: white;
      text-decoration: none;
    }
    .bottom-content {
      margin-top: 48px;
  }
    .bottom-content {
      margin-top: 48px;
      display: flex;
      gap: 2%;
  }
    .counts {
      font-weight: 700;
      font-size: 40px;
      line-height: 100%;
      vertical-align: middle;
      margin-right: 32px;
  }
    .info {
      font-weight: 400;
      font-size: 16px;
      line-height: 22px;
      padding-top: 6px;
      margin-right: 32px;
  }
    .content {
      border-right: 1px solid rgba(0, 0, 0, 0.1);
  }
</style>
<div class="custom-banner">
  <div class="custom-banner-wrapper  page-width">
    <div class="right-side-block">
      <div class="banner-image">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 400 | image_tag }}
        {% endif %}
      </div>
    </div>
    <div class="left-side-container">
      <div class="top-content">
        {% if section.settings.text != blank %}
          <h2 class="heading">{{ section.settings.text }}</h2>
        {% endif %}
        {% if section.settings.sub_text != blank %}
          <div class="sub-heading">{{ section.settings.sub_text }}</div>
        {% endif %}
        {% if section.settings.button_text != blank and section.settings.button_url != blank %}
          <a class="custom-button" href="{{ section.settings.button_url }}">{{ section.settings.button_text }}</a>
        {% endif %}
      </div>
      <div class="bottom-content">
        {% for block in section.blocks %}
          <div class="content">
            {% if block.settings.counts != blank %}
              <div class="counts">{{ block.settings.counts }}</div>
            {% endif %}
            {% if block.settings.label != blank %}
              <div class="info">{{ block.settings.label }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Section name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "sub_text",
      "label": "Sub Heading"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URl"
    }
  ],
  "blocks": [
    {
      "type": "info-block",
      "name": "Information",
      "settings": [
        {
          "type": "text",
          "id": "counts",
          "label": "Counts"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Information"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
