<style>
  .collection-section {
    padding-top: 72px;
  }
  .collection-section h2 {
    font-weight: 700;
    font-size: 48px;
    line-height: 100%;
    text-align: center;
    vertical-align: middle;
    text-transform: uppercase;
  }
  .products-grid {
    display: flex;
    gap: 20px;
    width: 100%;
    justify-content: space-around;
  }
  .product-item {
    width: 20%;
}
  .product-item a {
    text-decoration: none;
    color: black;
  }
  .product-img {
    border-radius: 20px;
    height: 298px;
  }
  .product-item h3 {
    font-weight: 700;
    font-size: 20px;
    line-height: 100%;
    vertical-align: middle;
}
  .product-item p {
    font-weight: 700;
    font-size: 24px;
    line-height: 100%;
    vertical-align: middle;
}
  .view-all-button .btn {
    text-decoration: none;
    color: black;
    border: 1px solid rgba(0, 0, 0, 0.1);
    padding: 16px 54px;
    border-radius: 64px;
}
  .view-all-button {
    text-align: center;
    padding-top: 36px;
}
</style>
<div class="collection-section page-width">
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}

  {% assign selected_collection = collections[section.settings.collection] %}
  
  {% if selected_collection != blank and selected_collection.products_count > 0 %}
    <div class="products-grid">
      {% for product in selected_collection.products limit: section.settings.prod_count %}
        <div class="product-item">
          <a href="{{ product.url }}">
            {% if product.featured_image %}
              <div class="product-img">
              <img src="{{ product.featured_image | img_url: 'medium' }}" alt="{{ product.title }}">
              </div>
            {% endif %}
            <h3>{{ product.title }}</h3>
            <p>{{ product.price | money }}</p>
          </a>
        </div>
      {% endfor %}
    </div>
    
    {% if section.settings.button_url != blank %}
      <div class="view-all-button">
        <a href="{{ section.settings.button_url }}" class="btn">
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}
  {% else %}
    <p>No products available in this collection.</p>
  {% endif %}
</div>

{% schema %}
  {
    "name": "Section name",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      },
      {
        "type": "range",
        "id": "prod_count",
        "label": "Product Count",
        "min": 4,
        "max": 12,
        "step": 1,
        "default": 4
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button Text",
        "default": "View All"
      },
      {
        "type": "url",
        "id": "button_url",
        "label": "Button URL"
      }
    ],
    "presets": [
      {
        "name": "Custom Collection"
      }
    ]
  }
{% endschema %}