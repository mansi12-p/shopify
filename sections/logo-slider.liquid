<style>
  .logo-slider {
    background: black;
    padding: 44px 0;
  }

  .logo-slider-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    gap: 24px;
  }

  .logos {
    flex: 0 0 auto;
  }

  .logos img {
    height: auto;
    width: 100%;
    max-width: 166px;
    object-fit: contain;
    display: block;
  }

  @media screen and (max-width: 768px) {
    .logo-slider-wrapper {
      justify-content: center;
      gap: 16px;
      padding: 32px 16px;
    }

    .logos img {
      max-width: 120px;
    }
  }

  @media screen and (max-width: 480px) {
    .logo-slider-wrapper {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding: 16px;
    }

    .logos {
      flex: 0 0 auto;
    }

    .logos img {
      max-width: 100px;
    }
  }
</style>

<div class="logo-slider">
  <div class="logo-slider-wrapper">
    {% for block in section.blocks %}
      <div class="logos">
        {{ block.settings.logo_image | image_url: width: 167 | image_tag }}
      </div> 
      {% endfor %}
  </div>
</div>
{% schema %}
  {
    "name": "Logo Slider",
    "blocks": [
      {
        "type": "logo-slider",
        "name": "logos",
        "settings": [
          {
            "type": "image_picker",
            "id": "logo_image",
            "label": "Logo"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Logo Slider"
      }
    ]
  }
{% endschema %}