<div class="logo-slider">
  <div class="logo-slider-wrapper">
    {% for block in section.blocks %}
      <div class="logos">
        {{ block.settings.logo_image | image_url: width: 167 | image_tag }}
      </div> 
      {% endfor %}
  </div>
</div>
{% schema %}
  {
    "name": "Logo Slider",
    "blocks": [
      {
        "type": "logo-slider",
        "name": "logos",
        "settings": [
          {
            "type": "image_picker",
            "id": "logo_image",
            "label": "Logo"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Logo Slider"
      }
    ]
  }
{% endschema %}