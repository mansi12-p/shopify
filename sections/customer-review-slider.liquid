<style>
  .review-slider {
    padding-top: 80px;
}
  h2.review-heading {
    font-weight: 700;
    font-size: 48px;
    vertical-align: middle;
}
  div.swiper-wrapper {
    padding-top: 40px;
}
  .swiper-button-prev:after,
  .swiper-button-next:after {
    display: none;
}
  .swiper-button-prev {
    transform: rotate(180deg);
}
</style>
<div class="review-slider swiper page-width">
  {% if section.settings.heading != blank %}
    <h2 class="review-heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      <div class="swiper-slide review-slide">
        {% if block.settings.ratting_icon %}
          <div class="rating-icon">
            <img src="{{ block.settings.ratting_icon | img_url: 'small' }}" alt="Rating">
          </div>
        {% endif %}
        <div class="review-content">
          <div class="review-user">
          <span>{{ block.settings.user_name }} </span><span>{{ 'verified.svg' | inline_asset_content }}</span>
          </div>
           <div class="review-text">
            {{ block.settings.review_text }}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
  <div class="swiper-button-prev">{{ 'previous-arrow.svg' | inline_asset_content }}</div>
  <div class="swiper-button-next">{{ 'next-arrow.svg' | inline_asset_content }}</div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.review-slider.swiper', {
      loop: true,
      slidesPerView: 1,
      spaceBetween: 20,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev'
      },
      breakpoints: {
        768: {
          slidesPerView: 2
        },
        1024: {
          slidesPerView: 3
        }
      }
    });
  });
</script>

{% schema %}
  {
    "name": "Section name",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
      }
    ],
    "blocks": [
      {
        "type": "reviews",
        "name": "Reviews",
        "settings": [
          {
            "type": "image_picker",
            "id": "ratting_icon",
            "label": "Ratting Icon"
          },
          {
            "type": "text",
            "id": "user_name",
            "label": "User Name"
          },
          {
            "type": "richtext",
            "id": "review_text",
            "label": "Review"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Review Slider"
      }
    ]
  }
{% endschema %}