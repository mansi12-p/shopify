{% assign secret_password = 'mysecret123' %}

<div id="secured-collection" class="secured-collection-wrapper">
  <div id="password-form">
    <form onsubmit="return validatePassword(event)">
      <label for="password">Enter password to view this collection:</label>
      <input type="password" id="collection-password" required>
      <button type="submit">Submit</button>
      <p id="error-msg" style="color:red; display:none;">Incorrect password. Please try again.</p>
    </form>
  </div>

  <div id="collection-content" style="display:none;">
     {% for product in collection.products %}
      <div class="product-item">
        <h3>{{ product.title }}</h3>
        <a href="{{ product.url }}">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: 'medium' }}" alt="{{ product.title }}">
          {% endif %}
        </a>
        <p>{{ product.price | money }}</p>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  const correctPassword = '{{ secret_password }}';

  function validatePassword(event) {
    event.preventDefault();
    const input = document.getElementById('collection-password').value;

    if (input === correctPassword) {
      localStorage.setItem('unlocked_collection', 'true');
      showCollectionContent();
    } else {
      document.getElementById('error-msg').style.display = 'block';
    }
  }

  function showCollectionContent() {
    document.getElementById('password-form').style.display = 'none';
    document.getElementById('collection-content').style.display = 'flex';
  }

  if (localStorage.getItem('unlocked_collection') === 'true') {
    showCollectionContent();
  }
</script>
